# ---- App ----
# Public URL of the site (no trailing slash). Must be HTTPS in production.
APP_URL=https://your-app.up.railway.app
# Brand shown in the UI and bot messages.
APP_NAME=Lumen
# Postgres connection string (Railway provides this automatically).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imgplatform
# Where uploaded/generated images are stored (mount a Railway volume here).
STORAGE_DIR=./data/images

# ---- Telegram ----
# From @BotFather. Keep secret.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. LumenEditBot
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back on every webhook call. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---- Image provider (server-side only, never shown to users) ----
PROVIDER_API_KEY=
# Optional overrides; defaults are set in src/server/providers/bria.ts
PROVIDER_BASE_URL=
PROVIDER_MODEL_VERSION=
# Set to 1 to use a local fake provider (development / demos, no API calls).
PROVIDER_MOCK=0

# ---- Solana payments ----
# PUBLIC receiving wallet address. NEVER put a seed phrase or private key anywhere.
SOLANA_RECIPIENT=
# Solana RPC endpoint (a paid RPC like Helius is recommended for production).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Accepted tokens, comma separated: SOL,USDC,USDT
SOLANA_TOKENS=SOL,USDC,USDT

# ---- Business ----
# Credits given to a brand-new account (0 = none).
FREE_STARTER_CREDITS=0
